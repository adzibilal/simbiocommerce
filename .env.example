# ─── Wajib diisi (tidak bisa dari admin panel) ────────────────────────────────

# Koneksi database PostgreSQL
DATABASE_URL="postgres://user:password@host:5432/dbname"

# Auth secret — generate dengan: openssl rand -base64 32
NEXTAUTH_SECRET="ganti-dengan-random-string-panjang"

# URL domain deployment ini
NEXTAUTH_URL="https://domain-client.com"

# Encryption key untuk enkripsi settings di DB — generate: openssl rand -base64 32
ENCRYPTION_KEY="ganti-dengan-32-char-key-panjang"

# ─── ImageKit (untuk upload gambar) ───────────────────────────────────────────
IMAGEKIT_PRIVATE_KEY="private_xxxxxxxxxxxx"
IMAGEKIT_PUBLIC_KEY="public_xxxxxxxxxxxx"
IMAGEKIT_FOLDER="nama-folder-client"

# ─── Bisa dikonfigurasi via Admin Panel (Store Settings) ──────────────────────
# Midtrans  → /admin/store-settings/payment
# RajaOngkir → /admin/store-settings/courier
# Email     → /admin/store-settings/email
